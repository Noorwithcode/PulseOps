NODE_ENV=development
PORT=5000

# Browser frontend origin.
# Multiple trusted origins may be comma-separated.
# Optional for the included same-origin production deployment.
# A configured production origin must use HTTPS.
FRONTEND_URL=http://localhost:5173

# Leave unset for direct/local access.
# If deployed behind exactly one trusted reverse proxy, use:
# TRUST_PROXY=1
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=pulseops_app
DB_PASSWORD=replace_with_database_password
DB_NAME=pulseops
DB_CONNECTION_LIMIT=10
# Use true for TLS-only cloud databases such as TiDB Cloud.
DB_SSL=false

ADMIN_FULL_NAME=PulseOps Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Replace this example with your own random value before production use.
JWT_SECRET=replace_this_with_a_secure_random_secret_that_is_at_least_64_characters_long_1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# HTTP hardening.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Used only by npm run test:incident-flow.
INCIDENT_TEST_SERVER_ID=1
